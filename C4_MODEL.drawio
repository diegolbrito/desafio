<mxfile host="Electron" agent="Claude Code" pages="2">
  <diagram id="c4-nivel-1-contexto" name="Nível 1 — Contexto">
    <mxGraphModel dx="1100" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1-titulo" value="&lt;b&gt;Credit Engine — C4 Nível 1: Contexto do sistema&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Motor de precificação e liquidação de recebíveis de um FIDC (caixa multimoedas BRL/USD).&lt;/font&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="980" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1-operador" value="&lt;b&gt;Operador da mesa de operações&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Pessoa]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Submete lotes de recebíveis para precificação, acompanha o resultado e liquida os recebíveis precificados." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="120" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1-sre" value="&lt;b&gt;Engenharia / SRE&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Pessoa]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Acompanha saúde da aplicação, métricas de negócio e volume financeiro processado." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1-sistema" value="&lt;b&gt;Credit Engine&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema de software]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Recebe lotes de recebíveis, calcula o deságio por valor presente (precisão decimal exata), registra a transação de forma auditável e liquida recebíveis de forma idempotente." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="360" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n1-fx" value="&lt;b&gt;Serviço de cotação de câmbio&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Fonte da cotação USD/BRL usada na conversão cross-currency. Em desenvolvimento, mockado via WireMock." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="630" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n1-e1" value="Cria lotes, consulta e liquida&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-operador" target="n1-sistema">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1-e2" value="Acompanha métricas&lt;br&gt;e dashboards" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-sre" target="n1-sistema">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1-e3" value="Busca cotação USD/BRL [HTTP/JSON]&lt;br&gt;timeout curto, circuit breaker e fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1-sistema" target="n1-fx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1-legenda" value="Legenda" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0B0B0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#666666;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n1-lg1" value="Pessoa / ator" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="260" height="28" as="geometry" />
