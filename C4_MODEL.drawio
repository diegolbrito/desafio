        <mxCell id="n1-lg4" value="Sistema externo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
