        <mxCell id="n1-lg3" value="Container (detalhado no nível 2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="712" width="260" height="28" as="geometry" />
