        <mxCell id="n2-titulo" parent="1" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;fontColor=#333333;" value="&lt;b&gt;Credit Engine — C4 Nível 2: Containers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Unidades executáveis do sistema, como sobem no docker-compose.&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="1280" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="n2-boundary" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=8;fontColor=#444444;fontStyle=1;fontSize=12;" value="Sistema: Credit Engine" vertex="1">
          <mxGeometry height="560" width="1280" x="60" y="260" as="geometry" />
        </mxCell>
        <mxCell id="n2-operador" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Operador da mesa de operações&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Pessoa]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="110" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n2-sre" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Engenharia / SRE&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Pessoa]&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="950" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n2-frontend" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Frontend (SPA)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[React 19 + TypeScript, build Vite, servido por nginx]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Formulário de criação de lote, listagem/detalhe de lotes e ação de liquidação. Também faz proxy reverso de /api/* para o backend, colocando SPA e API na mesma origem.&lt;br&gt;&lt;br&gt;&lt;b&gt;porta 3000&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="290" x="110" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n2-backend" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Java 25 + Spring Boot 4.1, arquitetura hexagonal]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Precificação por valor presente (BigDecimal, sem ponto flutuante), liquidação idempotente com lock pessimista, extrato analítico de liquidação e trilha de eventos auditável. Expõe REST /api/v1, OpenAPI/Swagger e /actuator/prometheus.&lt;br&gt;&lt;br&gt;&lt;b&gt;porta 8080&lt;/b&gt;" vertex="1">
          <mxGeometry height="190" width="310" x="520" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n2-grafana" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Grafana 11.4]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Dashboards de métricas de negócio e de saúde da aplicação, provisionados por arquivo.&lt;br&gt;&lt;br&gt;&lt;b&gt;porta 3001&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="290" x="950" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n2-prometheus" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;verticalAlign=top;spacingTop=6;" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Prometheus 3.0]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Armazena as séries temporais coletadas do backend (métricas HTTP/JVM e de negócio).&lt;br&gt;&lt;br&gt;&lt;b&gt;porta 9090&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="290" x="950" y="580" as="geometry" />
        </mxCell>
        <mxCell id="n2-db" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Banco de dados&lt;/b&gt;&lt;br&gt;&lt;i&gt;[PostgreSQL 18, migrations via Flyway]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Lotes, recebíveis, taxas base por moeda, categorias de risco e eventos de transação (append-only). Valores monetários em NUMERIC; soft delete em tabelas de domínio." vertex="1">
          <mxGeometry height="170" width="300" x="380" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n2-fx" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Serviço de cotação de câmbio&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo — mockado com WireMock 3.9 em dev, porta 8089]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Fornece a cotação USD/BRL usada nas conversões cross-currency." vertex="1">
          <mxGeometry height="140" width="340" x="700" y="900" as="geometry" />
        </mxCell>
        <mxCell id="n2-e1" edge="1" parent="1" source="n2-operador" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="n2-frontend" value="Usa [HTTPS]">
