<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nome "logback-spring.xml" (nao "logback.xml") de proposito: assim o Spring
  Boot carrega esse arquivo DEPOIS do ambiente estar pronto, habilitando o
  springProperty abaixo e a tag springProfile (ver SPEC.md, "Arquitetura
  Backend e decisoes" > "Logging").
-->
<configuration>

    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="credit-engine"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [${applicationName}] [%thread] [%X{correlationId}] %logger{36} - %msg%n%throwable</pattern>
        </encoder>
    </appender>

    <!-- Pacote raiz da aplicacao: nivel mais verboso para acompanhar o fluxo de negocio. -->
    <logger name="com.srmasset.creditengine" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.springframework" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="org.hibernate" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="com.zaxxer.hikari" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="org.postgresql" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Perfil "dev": inspeciona query e parametros do Hibernate. org.hibernate.orm.jdbc.bind
         em TRACE loga os parametros vinculados - so faz sentido em desenvolvimento local,
         nunca em producao (podem aparecer valores de negocio nos parametros). Ativar com
         a opcao spring.profiles.active=dev ou a variavel SPRING_PROFILES_ACTIVE=dev. -->
    <springProfile name="dev">
        <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
